---
import { House, AlignLeft } from 'lucide-svelte';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="grid grid-rows-[auto_minmax(0, 1fr)]">
		<nav class="flex items-center justify-center text-black p-4 gap-12">
			<a class="flex items-center justify-center gap-2" class:>
				<House />
				<span class="text-lg">Home</span>
			</a>
			<a class="flex items-center justify-center gap-2">
				<AlignLeft />
				<span class="text-lg">Problems</span>
			</a>
		</nav>
		<slot />
	</body>
</html>
